.positions.json.*
.overlays.json.*
*.tmp
*.sqlite
*.db

# ── Claude Code personal settings (the shared .claude/settings.json IS committed) ──
.claude/settings.local.json
CLAUDE.local.md

# ── Python ──
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# ── Node / frontend ──
node_modules/
dist/
build/
.vite/
*.local

# ── Editor / OS ──
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ── Cloud server backups (scripts/linux/backup.sh) ──
backups/

