# Copy this file to .env and fill in the values yourself.
#   Windows:  copy env.example .env
#   Mac:      cp env.example .env
# (This template has no leading dot on purpose: Claude Code may read it, but never .env.)
# .env is in .gitignore so it never gets committed, and Claude Code is blocked from reading it.
# Never paste keys into the Claude chat.

# ── Toss Securities Open API ──
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_ACCOUNT_NO=

# ── Anthropic (from phase 2) ──
ANTHROPIC_API_KEY=

# ── Safety switch ──
# While true, the order API is never actually called. Switch to false yourself only when you want real orders.
DRY_RUN=true

# ── Access protection (from phase 5) ──
APP_PASSCODE=
ORDER_PIN=


# ── Fred (from phase 1) ──
FRED_API_KEY=

# ── Finnhub.io (from phase 3) ──
FINNHUB_API_KEY=

# ── SEC EDGAR (from phase 6): your name + email, sent to SEC as the User-Agent ──
SEC_USER_AGENT=Trading Desk your.name@example.com


